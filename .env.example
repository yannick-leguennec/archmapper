# ─── Required ─────────────────────────────────────────────────────────────────

# Your Anthropic API key. Get one at https://console.anthropic.com/
# Never commit this value. The .env file is gitignored.
ANTHROPIC_API_KEY=your_api_key_here

# Name for this analysis run. Used as the output directory name under architecture/.
# Must contain only letters, numbers, and underscores (no spaces or hyphens).
# Example: MyProject, webapp2024, my_analysis
PROJECT_NAME=MyProject

# ─── Optional — model selection ───────────────────────────────────────────────

# Anthropic model for file-level analysis (high volume, factual extraction).
# Default: claude-sonnet-5 (best quality/cost balance for per-file work).
# Any current Anthropic model identifier works. See the latest names at
# https://docs.anthropic.com/en/docs/about-claude/models/overview
# If you point ArchMapper at a model not in src/llm-client.ts's PRICING table,
# the run still works; the cost summary falls back to Sonnet 5 intro rates.
# Note: Sonnet 5 defaults adaptive thinking ON; ArchMapper disables thinking
# on forced tool_choice calls (required by Anthropic's tool+thinking rules).
# FILE_MODEL=claude-sonnet-5

# Anthropic model for folder synthesis and the final architecture summary
# (lower volume, deeper reasoning).
# Default: claude-opus-5 (current Opus flagship).
# For lower cost on small codebases, set this to the same value as FILE_MODEL —
# Sonnet is fine for synthesis when modules are small.
# SYNTHESIS_MODEL=claude-opus-5

# ─── Optional — pipeline behavior ─────────────────────────────────────────────

# Path to the directory to analyze (relative to repo root, or absolute).
# Drop the codebase you want to analyze under this path before running.
# Default: project
# SCAN_ROOT=project

# Set to true to use the Anthropic Message Batches API. Asynchronous, ~50%
# cheaper per request. Recommended for any codebase larger than ~100 files.
# Smaller runs do not benefit much from batching.
# Default: false (synchronous mode)
# USE_BATCHES=false

# Comma-separated directory/file patterns to exclude from the scan.
# Matched as substrings against file paths. Any file whose path contains one
# of these substrings is skipped.
# Default: node_modules,dist,build,.git
# EXCLUDE_PATTERNS=node_modules,dist,build,.git

# Maximum tokens per LLM response. Increase if your codebase has very large
# files or very dense modules; decrease to cap cost.
# Default: 4096
# MAX_TOKENS=4096

# ─── Optional — runtime / logging ─────────────────────────────────────────────

# Runtime environment. Affects default log level.
# Values: development | test | production
# Default: development
# NODE_ENV=development

# Minimum log level to emit. Overrides NODE_ENV default.
# Values: DEBUG | INFO | WARNING | ERROR
# Optional. Defaults: development=DEBUG, production=INFO
# LOG_LEVEL=

# ─── Notes on cost ────────────────────────────────────────────────────────────
# Prompt caching is automatic; repeated system prompts are reused at ~90% off.
# Combine USE_BATCHES=true + caching for the cheapest large-scale runs.
# A typical 500-file TypeScript repo runs at roughly $2 to $5 with both enabled.
